# Market Forge - bot engine config. COPY THIS FILE TO bot/.env and fill it in.
# bot/.env is gitignored - your keys never leave this machine.

# ---- Alpaca keys (alpaca.markets -> API Keys) ------------------------------
# START ON PAPER. Paper keys come from the paper dashboard (free, fake money).
STOCK_ENV=paper
ALPACA_KEY_ID=YOUR_PAPER_KEY_ID
ALPACA_SECRET_KEY=YOUR_PAPER_SECRET
# Live pair only when you're ready (STOCK_ENV=live uses THESE, never the paper pair):
ALPACA_LIVE_KEY_ID=
ALPACA_LIVE_SECRET_KEY=

# ---- serving ---------------------------------------------------------------
API_PORT=8796

# ---- sizing / training wheels (see RULES.md; all fail-closed) --------------
BOT_BANKROLL_CENTS=100000            # $1,000 sandbox the bot sizes against
RADAR_AUTO_EXECUTE=false             # auto-entries OFF until you flip this
LIVE_AUTO_ENABLED=false              # AND this (live only; both required)
RADAR_AUTO_MIN_SCORE=85
RADAR_AUTO_NOTIONAL_CENTS=5000       # $50/trade
RADAR_AUTO_MAX_PER_DAY=2
RADAR_AUTO_MAX_EXPOSURE_CENTS=15000  # $150 total auto capital
RADAR_AUTO_EXIT=trail                # trail | bracket
RADAR_AUTO_TRAIL_PCT=0.10            # sell 10% off the high-water mark
RADAR_AUTO_MIN_PRICE_CENTS=300       # ignore sub-$3 spiker junk

# ---- radar LLM triage (optional but recommended) ---------------------------
# Any OpenAI-compatible endpoint. Easiest local: install Ollama, then
#   ollama pull qwen2.5:3b   ->  base http://127.0.0.1:11434/v1, model qwen2.5:3b
# Leave RADAR_USE_LLM=false to run rules-only (alerts without scores;
# note: auto-entries require scores, so rules-only = alert-only mode).
RADAR_USE_LLM=false
RADAR_LLM_BASE_URL=http://127.0.0.1:11434/v1
RADAR_LLM_MODEL=qwen2.5:3b

# ---- optional extras -------------------------------------------------------
# Discord webhook for radar pings:
RADAR_DISCORD_WEBHOOK=
# FRED api key (macro data in the Market Brief):
FRED_API_KEY=

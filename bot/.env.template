# Market Forge - bot engine config. COPY THIS FILE TO bot/.env and fill it in.
# bot/.env is gitignored - your keys never leave this machine.

# ---- Alpaca keys (alpaca.markets -> API Keys) ------------------------------
# START ON PAPER. Paper keys come from the paper dashboard (free, fake money).
STOCK_ENV=paper
ALPACA_KEY_ID=YOUR_PAPER_KEY_ID
ALPACA_SECRET_KEY=YOUR_PAPER_SECRET
# Live pair only when you're ready (STOCK_ENV=live uses THESE, never the paper pair):
ALPACA_LIVE_KEY_ID=
ALPACA_LIVE_SECRET_KEY=

# ---- serving ---------------------------------------------------------------
API_PORT=8796

# ---- sizing / training wheels (see RULES.md; all fail-closed) --------------
BOT_BANKROLL_CENTS=100000            # $1,000 sandbox the bot sizes against
RADAR_AUTO_EXECUTE=false             # auto-entries OFF until you flip this
LIVE_AUTO_ENABLED=false              # AND this (live only; both required)
RADAR_AUTO_MIN_SCORE=85
RADAR_AUTO_NOTIONAL_CENTS=5000       # $50/trade
RADAR_AUTO_MAX_PER_DAY=2
RADAR_AUTO_MAX_EXPOSURE_CENTS=15000  # $150 total auto capital
RADAR_AUTO_EXIT=trail                # trail | bracket
RADAR_AUTO_TRAIL_PCT=0.10            # sell 10% off the high-water mark
RADAR_AUTO_MIN_PRICE_CENTS=300       # ignore sub-$3 spiker junk

# ---- radar catalyst scoring (signal vs noise, 0-100) -----------------------
# Scores ride your local coding-agent CLI (claude) - the same optional install
# that powers the copilot, nothing extra. No agent on PATH = alerts without
# scores, and auto-entries need scores, so that is also alert-only mode.
RADAR_USE_LLM=true
RADAR_AGENT_MODEL=haiku
# Prefer an OpenAI-compatible endpoint instead (Ollama, OpenRouter, ...)?
# Set RADAR_LLM_PROVIDER=openai and fill in the two lines below.
RADAR_LLM_PROVIDER=auto
RADAR_LLM_BASE_URL=
RADAR_LLM_MODEL=qwen2.5:3b

# ---- what the radars scan, and how often -----------------------------------
# All of this is editable in the app: each radar tab has a "Scan settings"
# button. Applying there rewrites this file and restarts the engine.
RADAR_SCAN_HOURS=10,12,14,16          # ET, weekdays. Comma separated, 0-23
RADAR_MIN_MOVE_PCT=5                  # how big a move has to be to get looked at
RADAR_TOP_N=20                        # movers pulled from the screener per scan
RADAR_MIN_PRICE_CENTS=300             # price floor for the radar list
RADAR_LLM_MIN_SCORE=60                # only alert at or above this 0-100 score

# Retail radar (reddit). One sub refreshes per cycle, round-robin, so a full
# sweep takes CACHE_SECS x the number of subs.
RADAR_REDDIT_ENABLED=true
RADAR_REDDIT_SUBS=wallstreetbets,swingtrading,stocks
RADAR_REDDIT_CACHE_SECS=600

# ---- the naked-position sweep ----------------------------------------------
# Every 30s, find any open position with no working exit and ARM one. This is
# the last line of the exit guarantee. Turning it off means a position that
# slips through gets a warning banner and nothing else.
SWEEP_AUTO_ARM=true
SWEEP_TRAIL_PCT=                      # blank = follow RADAR_AUTO_TRAIL_PCT

# ---- which coding agent ----------------------------------------------------
# Auto-detected: claude first, then codex. Both work. They differ in how the
# prompt is passed and what they print, which the app handles for you.
#   AGENT_KIND=claude|codex|auto   pin the dialect
#   AGENT_BIN=C:\full\path\to\cli  pin the binary (CLAUDE_BIN still works)
#   AGENT_ARGS=...                 override the flags entirely, {model}/{prompt}
# Without any agent the desk still runs: no copilot, no catalyst scores, and
# auto-entries cannot fire because they require a score.
AGENT_KIND=auto
AGENT_BIN=

# ---- optional extras -------------------------------------------------------
# Discord webhook for radar pings:
RADAR_DISCORD_WEBHOOK=
# FRED api key (macro data in the Market Brief):
FRED_API_KEY=
